# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The site's own canonical URL - used for metadataBase, sitemap.xml, and
# absolute links (share buttons, JSON-LD). Set to the real Vercel/custom
# domain in production; localhost is fine for development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional - override if the handles differ from the placeholder default.
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mallu_boys88/
# NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@mallu_boys88

# --- Phase 2: submissions, admin, support ---

# Supabase project settings > API > service_role key. SECRET - server-only,
# never prefixed NEXT_PUBLIC_. Every write in Phase 2 (submissions, admin
# mutations, storage moderation, the seen-confirmation RPC) goes through
# this key from a Server Action or Route Handler, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated allowlist of emails permitted to sign into /admin via
# magic link. Checked in proxy.ts (redirect convenience only) AND
# independently inside every admin server action/page (lib/auth.ts) -
# that second check is the real authorization boundary.
ADMIN_EMAILS=you@example.com

# Optional. If set, /report requires a passed Cloudflare Turnstile
# challenge as its third spam control (after the honeypot field and the
# Postgres-tracked IP rate limit). If unset, Turnstile is skipped entirely -
# handover works with only a Supabase and a Vercel account.
# TURNSTILE_SECRET_KEY=
