# Copy to .env.local for development (pnpm dev), or to .env on the server
# (docker compose). Never commit the copy.

# --- Development (pnpm dev) -------------------------------------------
# The SQLite database file. Created on first run by scripts/migrate.mjs.
# In the Docker image this is set to /data/db/entepalazhi.db (a volume),
# so it is not needed in the server's .env.
DATABASE_PATH=./data/entepalazhi.db

# Where photos are stored on disk (pending/ and public/ are created inside).
# Also preset in the Docker image (/data/uploads).
UPLOAD_DIR=./uploads

# The site's own address: used for canonical links, the sitemap and share
# links. http://localhost:3000 in development, https://entepalazhi.in live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: this PC's LAN address, to open the dev site from a phone.
# DEV_ORIGINS=192.168.1.20

# --- Production (docker compose reads these from .env) -----------------
# Optional: host port the site listens on (default 3000, localhost only).
# WEB_PORT=3000

# --- Optional, both environments ---------------------------------------
# Any long random string. Makes the stored IP hashes specific to this site.
# IP_HASH_SALT=

# Override the default social links (the Instagram link can also be changed
# from /admin/settings without touching this file).
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/ente_palazhi/
# NEXT_PUBLIC_YOUTUBE_URL=

# If set, the report form also requires a passed Cloudflare Turnstile
# challenge. Leave unset to skip it.
# TURNSTILE_SECRET_KEY=
